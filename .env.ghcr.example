# Settings for docker-compose.ghcr.yml. Copy to .env.ghcr and fill in.

MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# 32+ random characters, e.g. `openssl rand -base64 48`
JWT_SIGNING_KEY=

# Port the dashboard and gateway are served on
HTTP_PORT=80

# Image tag to run: latest, or a commit sha
IMAGE_TAG=latest

# Demo owner/consumer accounts plus generated usage history. If you turn this on for a host
# other people can reach, change SEED_PASSWORD.
SEED_DEMO_DATA=false
SEED_HISTORY_DAYS=21
SEED_PASSWORD=Password123!
