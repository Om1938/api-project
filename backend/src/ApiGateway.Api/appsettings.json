{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "MySql": "",
    "Redis": ""
  },
  "Jwt": {
    "Issuer": "api-gateway",
    "Audience": "api-gateway-dashboard",
    "SigningKey": "",
    "ExpiryMinutes": 480
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Seed": {
    "Enabled": false,
    "SampleHistoryDays": 0
  },
  "Webhooks": {
    "MaxAttempts": 3,
    "RetryBaseDelay": "00:00:02",
    "Timeout": "00:00:10"
  }
}
