# Copy to .env to override the defaults baked into docker-compose.yml.

MYSQL_DATABASE=apigateway
MYSQL_USER=gateway
MYSQL_PASSWORD=gateway
MYSQL_ROOT_PASSWORD=root

# Host ports
MYSQL_PORT=3306
REDIS_PORT=6379
UPSTREAM_PORT=8081
BACKEND_PORT=8080
FRONTEND_PORT=3000

# At least 32 characters. Change it for anything that is not a local demo.
JWT_SIGNING_KEY=demo-only-signing-key-change-me-0123456789abcdef

# Inserts a demo owner, consumer, API and tiers on first start.
SEED_DEMO_DATA=true

# Days of generated (fake) usage history for the demo API, so the charts are not empty. 0 = none.
SEED_HISTORY_DAYS=21
